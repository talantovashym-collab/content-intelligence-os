# Content Intelligence OS - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# APP SETTINGS
# ============================================
APP_NAME="Content Intelligence OS"
APP_VERSION="0.1.0"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ============================================
# SECURITY
# ============================================
# Generate with: openssl rand -base64 32
SECRET_KEY="your-secret-key-here-generate-with-openssl-rand-base64-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ============================================
# DATABASE
# ============================================
# PostgreSQL with pgvector extension
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/content_intelligence"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379/0"

# ============================================
# CELERY (Background Jobs)
# ============================================
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ============================================
# CORS
# ============================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# ============================================
# AI PROVIDERS (Optional)
# ============================================
# Set the key for ANY ONE provider; every AI feature uses it. Without a key the
# app still works and generates template output. With several keys set, the
# first in this list is used unless LLM_PROVIDER names one:
#   openai, anthropic, gemini, mistral, groq, deepseek, openrouter,
#   nvidia, vercel, teamorouter, tokenharbor, ollama
# If that provider fails (no credit, overloaded), the request moves on to the
# next configured one; set LLM_FALLBACK=false to turn that off.
LLM_PROVIDER=""
# Optional: which providers to fall back to, in order (default: all configured)
LLM_FALLBACK_ORDER=""
# Optional: override the provider's default model (e.g. gpt-4o, gemini-2.5-pro,
# mistral-small-latest). Leave empty for the default.
LLM_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
MISTRAL_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
NVIDIA_API_KEY=""
AI_GATEWAY_API_KEY=""
TEAMOROUTER_API_KEY=""
TOKENHARBOR_API_KEY=""
# Local models via Ollama (from Docker): http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=""
ELEVENLABS_API_KEY=""

# ============================================
# SOCIAL MEDIA APIs (Optional - for publishing)
# ============================================
# YouTube
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Instagram/Facebook
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ============================================
# STORAGE
# ============================================
STORAGE_TYPE="local"  # local or s3
LOCAL_STORAGE_PATH="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=""
PROMETHEUS_PORT=9090