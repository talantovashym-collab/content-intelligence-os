generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStage {
  IDEA
  RESEARCH
  REFERENCE_COLLECTION
  INVESTIGATION
  CREATIVE_STRATEGY
  PRODUCTION
  TESTING
  PUBLISHING
  PUBLISHED
  ANALYSIS
  COMPLETED
}

enum OpportunityStatus {
  DISCOVERED
  RESEARCHING
  VALIDATED
  REJECTED
  ARCHIVED
}

enum ReferenceStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  INDEXING
  INDEXED
  ANALYZING
  ANALYZED
  FAILED
  ARCHIVED
}

enum MediaType {
  VIDEO
  AUDIO
  IMAGE
  DOCUMENT
}

enum AnalysisType {
  SCENE
  FRAME
  COMPOSITION
  CAMERA
  VISUAL_HIERARCHY
  COLOR_LIGHTING
  OBJECTS_CHARACTERS
  EXPRESSIONS
  TRANSITIONS
  VISUAL_EFFECTS
  OCR
  HEADLINES
  CAPTIONS
  SUBTITLES
  ANIMATED_TYPOGRAPHY
  TEXT_POSITION
  SPEECH_TRANSCRIPTION
  VOICEOVER
  DIALOGUE
  SPEAKER_IDENTIFICATION
  SPEECH_SPEED
  TONE
  PAUSES
  MUSIC
  SOUND_EFFECTS
  RHYTHM
  HOOKS
  STORYTELLING
  CURIOSITY_LOOPS
  EMOTIONAL_TRIGGERS
  NARRATIVE_STRUCTURE
  ANIMATION
  MOTION_GRAPHICS
  EDITING
  TIMING
  PACING
  CTAS
  PAYOFFS
}

enum CreativeFormat {
  STICKMAN
  DOODLE
  WHITEBOARD
  CARTOON
  MOTION_GRAPHICS
  CINEMATIC
  DOCUMENTARY
  EDUCATIONAL
}

enum TestType {
  HOOK_ALTERNATIVE
  OPENING_SCENE
  SCRIPT_ALTERNATIVE
  VOICEOVER_ALTERNATIVE
  NARRATIVE_APPROACH
  ANIMATION_VARIATION
  DURATION_COMPARISON
  VISUAL_CONSISTENCY
  AUDIO_QUALITY
  SUBTITLE_VERIFICATION
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
  TWITTER
  LINKEDIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]
  sessions      Session[]
  apiKeys       ApiKey[]
  preferences   UserPreferences?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  keyHash     String
  label       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultLanguage    String   @default("en")
  defaultCountry     String   @default("US")
  defaultPlatform    Platform @default(YOUTUBE)
  theme              String   @default("dark")
  notifications      Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Project {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  stage                  ProjectStage  @default(IDEA)
  niche                  String?
  targetAudience         String?
  language               String        @default("en")
  country                String        @default("US")
  platforms              Platform[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  opportunities          Opportunity[]
  references             Reference[]
  investigations         Investigation[]
  strategies             CreativeStrategy[]
  productions            Production[]
  tests                  Test[]
  publications           Publication[]
  analytics              Analytics[]
  knowledgeEntries       KnowledgeEntry[]
  multiReferenceAnalyses MultiReferenceAnalysis[]
}

model Opportunity {
  id                 String           @id @default(cuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  topicDescription   String
  targetAudience     String
  audienceNeed       String
  marketEvidence     Json
  relevantTrends     Json
  competingContent   Json
  referenceVideos    Json
  relevantCreators   Json
  performanceData    Json
  audienceReactions  Json
  creativeFormats    CreativeFormat[]
  potentialHooks     Json
  risks              Json
  confidenceLevel    Float
  recommendedActions Json
  status             OpportunityStatus @default(DISCOVERED)
  rankScores         Json
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Reference {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceUrl       String?
  sourcePlatform  Platform?
  creatorId       String?
  creatorName     String?
  title           String
  description     String?
  mediaType       MediaType
  mediaUrl        String?
  localPath       String?
  thumbnailUrl    String?
  duration        Float?
  publishedAt     DateTime?
  engagementMetrics Json
  hashtags        String[]
  captions        String?
  status          ReferenceStatus @default(PENDING)
  metadata        Json
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  investigations  Investigation[]
}

model Investigation {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceId     String
  reference       Reference     @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  analysisType    AnalysisType
  findings        Json
  evidence        Json
  interpretations Json
  confidenceLevel Float
  creativeApplications Json
  timestampedReport Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model MultiReferenceAnalysis {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceIds          String[]
  sharedCreativeDna     Json
  commonVisualPatterns  Json
  commonHooks           Json
  narrativeStructures   Json
  editingStyles         Json
  animationFormulas     Json
  emotionalMechanisms   Json
  audienceReactions     Json
  performanceDifferences Json
  creativeOutliers      Json
  styleProfile          Json
  storytellingProfile   Json
  transferPrinciples    Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CreativeStrategy {
  id                  String         @id @default(cuid())
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept             String
  topic               String
  targetAudience      String
  creativeAngle       String
  coreMessage         String
  emotionalObjective  String
  hookDirection       String
  narrativeFormula    String
  visualStyle         String
  animationStyle      String
  duration            Int
  platformAdaptations Json
  differentiation     String
  alternatives        Json
  isApproved          Boolean        @default(false)
  approvedAt          DateTime?
  approvalFeedback    String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  productions         Production[]
}

model Production {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategyId      String
  strategy        CreativeStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  format          CreativeFormat
  script          Json
  hooks           Json
  voiceover       Json
  storyboard      Json
  characterDesigns Json
  animationInstructions Json
  visualPrompts   Json
  imageAssets     Json
  videoAssets     Json
  soundDesign     Json
  musicDirection  Json
  editingInstructions Json
  captions        Json
  subtitles       Json
  timeline        Json
  version         Int           @default(1)
  status          String        @default("draft")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tests           Test[]
}

model Test {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productionId    String?
  production      Production? @relation(fields: [productionId], references: [id], onDelete: SetNull)
  testType        TestType
  variants        Json
  results         Json
  qualityAssessment Json
  performanceHypothesis Json
  audienceExperiment Json
  status          String     @default("pending")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Publication {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productionId    String
  platform        Platform
  accountId       String
  title           String
  description     String
  tags            String[]
  hashtags        String[]
  coverImageUrl   String?
  videoUrl        String
  scheduledAt     DateTime?
  publishedAt     DateTime?
  status          PublishStatus @default(DRAFT)
  platformPostId  String?
  platformUrl     String?
  errorMessage    String?
  metadata        Json
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Analytics {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publicationId       String
  platform            Platform
  views               BigInt
  watchTime           BigInt
  retention           Json
  completionRate      Float
  likes               Int
  comments            Int
  shares              Int
  saves               Int
  followerGrowth      Int
  engagementRate      Float
  performanceOverTime Json
  predictedVsActual   Json
  successfulElements  Json
  weakPoints          Json
  improvementOpps     Json
  crossPlatformCompare Json
  collectedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model KnowledgeEntry {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category            String
  title               String
  content             Json
  evidence            Json
  sourceType          String
  sourceReference     String?
  confidenceLevel     Float
  isValidated         Boolean  @default(false)
  validatedAt         DateTime?
  tags                String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   Json?
  userId    String?
  projectId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([projectId])
}